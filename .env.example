# ===========================================================================
# .env.example — шаблон локальных настроек.
#
# Скопируйте в .env:  cp .env.example .env   — и подставьте свои значения.
# .env НЕ коммитится (см. .gitignore): там живут секреты. Этот файл — нет,
# поэтому в нём только ПЛЕЙСХОЛДЕРЫ, никогда настоящие секреты.
#
# Значения ниже совпадают с дефолтами config.Load() — где они есть,
# переменную можно вообще не задавать.
# ===========================================================================

# --- Postgres -------------------------------------------------------------
# POSTGRES_HOST в docker-compose выставит "db" (имя сервиса), здесь —
# значение для локального запуска без докера.
POSTGRES_USER=notes_user
POSTGRES_PASSWORD=notes_pass
POSTGRES_DB=notes_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# sslmode: disable (локально) | require | verify-full (прод, БД за сетью)
POSTGRES_SSLMODE=disable
# Размер пула соединений приложения к БД. MaxConns — потолок одновременных
# коннектов (запросы сверх него ждут в очереди пула); MinConns — сколько
# держать открытыми заранее. Подбирается замером (hey + Grafana), не "чем
# больше тем лучше": каждый коннект — процесс на стороне Postgres.
# Дефолты 10/2 — те же, что раньше были захардкожены в NewPool.
PGX_MAX_CONNS=10
PGX_MIN_CONNS=2

# --- App -------------------------------------------------------------------
APP_PORT=8080

# Секрет подписи JWT. ВАЖНО: настоящий секрет генерируйте случайно,
# например: openssl rand -hex 32. Никогда не используйте пример ниже.
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
# Срок жизни ACCESS-токена (короткий — он летает в каждом запросе).
JWT_TTL=15m
# Срок жизни REFRESH-токена (длинный, хранится в БД, можно отозвать).
REFRESH_TTL=720h
# Период фоновой чистки протухших refresh-токенов.
REFRESH_CLEANUP_INTERVAL=1h

# --- CORS ------------------------------------------------------------------
# Разрешённые origin'ы через запятую. Дефолт ниже — dev-фронтенд на :3000.
# "*" запрещён по дизайну: любой сайт получил бы доступ к API.
CORS_ALLOWED_ORIGINS=http://localhost:3000