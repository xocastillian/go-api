# ===========================================================================
# Dockerfile — как собрать образ сервиса api.
#
# Это multi-stage (многоэтапная) сборка: в первом этапе есть весь Go-тулчейн
# (он тяжёлый), во втором остаётся только готовый бинарь и нужные файлы.
# Тяжёлый слой сборки в финальный образ НЕ попадает.
# ===========================================================================

# ---------------------------------------------------------------------------
# ЭТАП 1 — СБОРКА (образ большой, но временный)
# ---------------------------------------------------------------------------
FROM golang:1.27-alpine AS build

WORKDIR /src

# Сначала копируем ТОЛЬКО манифесты зависимостей.
# Docker кэширует слои: пока go.mod/go.sum не менялись, слой с `go mod download`
# переиспользуется, и правка Go-кода НЕ тянет повторную скачку модулей.
# Это главный приём быстрых сборок — порядок COPY имеет значение.
COPY go.mod go.sum ./
RUN go mod download

# Теперь исходники. Именно после модулей: изменение кода не должно
# инвалидировать кэш слоя с уже скачанными зависимостями.
COPY . .

# Собираем ДВА бинаря:
#   api   — сам сервер;
#   goose — CLI миграций, нужен на старте контейнера (см. docker/entrypoint.sh).
#
# CGO_ENABLED=0 — полностью статический бинарь, без зависимости от libc.
# Это важно: финальный образ (alpine) использует musl, а не glibc. Бинарь,
# собранный с CGO под glibc, в alpine упал бы при запуске.
RUN CGO_ENABLED=0 go build -o /out/api ./cmd/api && \
    CGO_ENABLED=0 go build -o /out/goose github.com/pressly/goose/v3/cmd/goose

# ---------------------------------------------------------------------------
# ЭТАП 2 — ЗАПУСК (маленький финальный образ)
# ---------------------------------------------------------------------------
# Только два бинаря и миграции: ни компилятора, ни исходников, ни кеша — 
# итоговый образ в разы меньше образа сборки.
FROM alpine:3.20

# Отдельный непривилегированный пользователь. Процесс в контейнере не должен
# быть root: если приложение скомпрометируют, прав у атакующего будет меньше.
RUN adduser -D -u 10001 app

WORKDIR /app

# Забираем из этапа сборки ровно то, что нужно для работы.
COPY --from=build /out/api /out/goose ./

# Миграции кладём рядом — entrypoint прогонит их goose'ом.
# Меняешь миграции → меняется образ → при следующем старте они применятся.
COPY db/migrations ./migrations

# Скрипт-точка входа: подготовка (сборка DSN + миграции) и запуск API.
COPY docker/entrypoint.sh ./entrypoint.sh
# chmod ОБЯЗАТЕЛЕН: без бита исполнения контейнер упадёт с "permission denied".
RUN chmod +x ./entrypoint.sh

# Дальше всё выполняется под непривилегированным пользователем.
USER app

# EXPOSE — это документация («сервис слушает этот порт»), а не публикация.
# Реальную проброску наружу делает docker-compose (ports).
EXPOSE 8080

# ENTRYPOINT — неизменяемая команда старта контейнера. Скрипт в конце сам
# сделает `exec ./api`, поэтому сервер станет PID 1 и получит SIGTERM
# от `docker stop` → сработает graceful shutdown.
ENTRYPOINT ["./entrypoint.sh"]